# Copy this file to .env for local development (never commit .env)
DB_URL=jdbc:mysql://localhost:3306/riya_industries?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=change_me_mysql_password

# Initial Admin Account (used on first boot if no admin exists)
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@riyaindustries.example
ADMIN_INIT_PASSWORD=ChangeThisStrongPassword123!

# Local Upload Directory (stored outside static webroot)
UPLOAD_DIR=./uploads
APP_PORT=8080
